# ---------------------------------------------------------------------------
# Plantilla de variables de entorno. Copia este archivo a `.env` y completa.
# NUNCA subas `.env` a Git ni pongas valores reales aquí.
# Documentación completa: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL local (pnpm db:up) -----------------------------------------
# Contraseña del contenedor de desarrollo. Debe coincidir con las URLs de abajo.
POSTGRES_PASSWORD=

# Base principal de desarrollo.
DATABASE_URL=postgresql://finanzas:<POSTGRES_PASSWORD>@127.0.0.1:5432/finanzas_dev
# Bases de pruebas: se BORRAN en cada ejecución. El nombre debe contener "test".
TEST_DATABASE_URL=postgresql://finanzas:<POSTGRES_PASSWORD>@127.0.0.1:5432/finanzas_test
E2E_DATABASE_URL=postgresql://finanzas:<POSTGRES_PASSWORD>@127.0.0.1:5432/finanzas_e2e_test

# --- API (apps/api) ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Orígenes del navegador permitidos (coma). En desarrollo, la web en :3000.
CORS_ORIGINS=http://localhost:3000
# Proxies de confianza para leer la IP real (la web reenvía desde localhost).
TRUST_PROXY=127.0.0.1,::1
# Secreto para seudonimizar IPs (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
LOG_LEVEL=info
SESSION_COOKIE_NAME=cf_session
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Opcionales (por defecto dependen de NODE_ENV):
# SESSION_COOKIE_SECURE=true
# API_DOCS_ENABLED=true

# --- Worker (apps/worker) ---------------------------------------------------
WORKER_TIMEZONE=America/Bogota
WORKER_QUEUE_SCHEMA=pgboss
# TRM oficial (USD/COP) desde datos abiertos del Gobierno (Superintendencia
# Financiera). No necesita credenciales. `disabled` desactiva la descarga.
FX_TRM_PROVIDER=datos-gov-co
# Opcionales:
# FX_TRM_APP_TOKEN=          # token de aplicación de datos.gov.co (sube los límites de uso)
# FX_TRM_TIMEOUT_MS=15000

# --- Web (apps/web) ---------------------------------------------------------
# Dirección interna de la API que usa el servidor de Next.js.
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Pruebas E2E (opcional) -------------------------------------------------
# Ruta a un Chromium ya instalado, si no usas `playwright install`.
# PW_CHROMIUM_PATH=
