{
  "name": "@cf/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Núcleo de dominio sin IO: datos de referencia y Financial Engine (Money, tasas, fechas, libro, saldos, flujo de caja).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "vitest": "5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  }
}
