{
  "name": "control-financiero",
  "private": true,
  "description": "Plataforma financiera personal inteligente — monorepo",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@cf/api --filter=@cf/web --filter=@cf/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run build --filter=@cf/api --filter=@cf/web && pnpm --filter @cf/e2e test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "db:up": "docker compose -f infrastructure/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml --env-file .env down",
    "db:new-migration": "pnpm --filter @cf/db db:generate",
    "db:setup": "turbo run build --filter=@cf/db && pnpm --filter @cf/db db:setup",
    "db:migrate": "turbo run build --filter=@cf/db && pnpm --filter @cf/db db:migrate",
    "db:seed": "turbo run build --filter=@cf/db && pnpm --filter @cf/db db:seed",
    "db:studio": "pnpm --filter @cf/db db:studio",
    "fx:sync": "turbo run build --filter=@cf/worker && pnpm --filter @cf/worker fx:sync --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
